{
  "name": "animspec",
  "version": "0.1.4",
  "description": "Deterministic declarative animation spec + reference interpreter",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tosin2013/animspec.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "assets/fonts/LICENSE-DejaVu.txt",
    "assets/fonts/LICENSE-JetBrainsMono.txt",
    "assets/fonts/LICENSE-IBMPlexMono.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "verify:registry": "tsx scripts/verify-registry.ts",
    "verify:validator": "tsx scripts/verify-spec-validator.ts",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "golden:update": "tsx scripts/golden-update.ts",
    "fonts:generate": "tsx scripts/generate-fonts.ts",
    "verify:gates": "tsx scripts/verify-gates.ts",
    "vocab:record": "tsx scripts/vocabulary-record.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "gallery:generate": "tsx scripts/generate-gallery.ts",
    "loops:generate": "tsx scripts/generate-loops.ts",
    "site:generate": "tsx scripts/generate-site.ts",
    "site:check": "tsx scripts/generate-site.ts --check",
    "site:dev": "vitepress dev docs",
    "site:build": "vitepress build docs",
    "verify:package": "tsx scripts/verify-package.ts",
    "verify": "npm run check && npm run verify:registry && npm run verify:validator && npm run verify:determinism && npm run verify:gates && npm run verify:package",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "mermaid": "11.17.2",
    "pixelarticons": "2.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.43"
  }
}
