{
  "name": "animspec",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic declarative animation spec + reference interpreter",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "check": "tsc",
    "verify:registry": "tsx scripts/verify-registry.ts",
    "verify:validator": "tsx scripts/verify-spec-validator.ts",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "golden:update": "tsx scripts/verify-determinism.ts --update",
    "verify": "npm run check && npm run verify:registry && npm run verify:validator && npm run verify:determinism",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@resvg/resvg-js": "2.6.2",
    "pixelarticons": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
