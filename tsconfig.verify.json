{
  "include": ["verify/**/*"],
  "compilerOptions": {
    "noEmit": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "declaration": true,
    "outDir": "dist-verify",
    "rootDir": "verify",
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
